<Window x:Class="ScreenRecordingTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenRecordingTool.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="屏幕录制工具" Height="450" Width="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 仅此按钮在程序启动时显示，点击后下方才会生成一组开始/停止按钮 -->
        <Button Grid.Row="0" Content="＋ 新增录制任务"
                Width="120" Height="32" Margin="0,0,0,8" HorizontalAlignment="Left"
                Command="{Binding AddSessionCommand}"/>

        <!-- 录制任务列表：每个会话对应一组独立的开始/停止按钮，可同时运行 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Sessions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:RecordSession">
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="开始录制"
                                        Width="100" Height="32" Margin="0,0,8,0"
                                        Command="{Binding StartCommand}"/>
                                <Button Content="停止录制"
                                        Width="100" Height="32"
                                        Command="{Binding StopCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding Settings.OutputDirectory, StringFormat=保存目录: {0}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
